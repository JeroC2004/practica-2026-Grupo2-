# Copiar como TPI/.env (está en .gitignore) y completar.

# Token gratuito de https://app.afipsdk.com (Afip SDK). Se usa con el CUIT de
# desarrollo compartido 20409378472 en el ambiente de homologación de ARCA.
ARCA_TOKEN=

# Punto de venta de homologación para emitir (default 4242). El 1 lo usa todo
# el mundo con el CUIT compartido y suele tener fechas futuras que bloquean.
ARCA_PUNTO_VENTA=

# Clave para firmar los JWT de sesión (opcional en desarrollo).
JWT_SECRET=
